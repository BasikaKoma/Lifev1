# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets — NOT in Vite)
# OPENAI_API_KEY=   # used by brain-run (web/Android). Desktop stores the key in OS safeStorage.
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=
# OURA_REDIRECT_URI=https://fxdnbepmiphyzebqdkyf.supabase.co/functions/v1/oura-oauth-callback
# OURA_SUCCESS_REDIRECT=http://127.0.0.1:17823/?oura=connected

# Desktop auto-update publish (local only — never commit or ship in the app)
# GitHub repo that hosts installers (Supabase free tier max upload is 50 MB)
GITHUB_OWNER=your-github-username
GITHUB_REPO=lifev1
GH_TOKEN=ghp_your_personal_access_token
